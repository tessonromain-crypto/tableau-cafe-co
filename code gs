function appliquerSemaineTypeUneSemaine() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const ui = SpreadsheetApp.getUi();

  const semaineType = ss.getSheetByName('SEMAINE_TYPE');

  if (!semaineType) {
    ui.alert('La feuille SEMAINE_TYPE est introuvable.');
    return;
  }

  // 1. Choix du mois cible
  const reponseMois = ui.prompt(
    'Mois cible',
    'Indique le nom exact du mois, par exemple : OCTOBRE',
    ui.ButtonSet.OK_CANCEL
  );

  if (reponseMois.getSelectedButton() !== ui.Button.OK) {
    return;
  }

  const nomMois = reponseMois.getResponseText().trim().toUpperCase();
  const feuilleMois = ss.getSheetByName(nomMois);

  if (!feuilleMois) {
    ui.alert('La feuille ' + nomMois + ' est introuvable.');
    return;
  }

  // 2. Choix du lundi
  const reponseLundi = ui.prompt(
    'Semaine cible',
    'Indique le lundi au format AAAA-MM-JJ, par exemple : 2026-10-05',
    ui.ButtonSet.OK_CANCEL
  );

  if (reponseLundi.getSelectedButton() !== ui.Button.OK) {
    return;
  }

  const texteLundi = reponseLundi.getResponseText().trim();
  const morceauxDate = texteLundi.split('-');

  if (morceauxDate.length !== 3) {
    ui.alert('Date invalide. Utilise le format AAAA-MM-JJ.');
    return;
  }

  const lundi = new Date(
    Number(morceauxDate[0]),
    Number(morceauxDate[1]) - 1,
    Number(morceauxDate[2]),
    12,
    0,
    0
  );

  if (isNaN(lundi.getTime()) || lundi.getDay() !== 1) {
    ui.alert('La date indiquée doit correspondre à un lundi.');
    return;
  }

  // 3. Toute la semaine type ou seulement un poste
  const choixMode = ui.alert(
    'Périmètre',
    'Oui = appliquer tous les postes.\nNon = appliquer seulement un poste.',
    ui.ButtonSet.YES_NO_CANCEL
  );

  if (choixMode === ui.Button.CANCEL) {
    return;
  }

  let posteChoisi = null;

  if (choixMode === ui.Button.NO) {
    const params = lireParametres_();
    const listePostes = params.postes.join(', ');

    const reponsePoste = ui.prompt(
      'Poste à appliquer',
      'Indique exactement un poste parmi : ' + listePostes,
      ui.ButtonSet.OK_CANCEL
    );

    if (reponsePoste.getSelectedButton() !== ui.Button.OK) {
      return;
    }

    posteChoisi = reponsePoste.getResponseText().trim();

    if (!params.postes.includes(posteChoisi)) {
      ui.alert('Poste inconnu : ' + posteChoisi);
      return;
    }
  }

  // 4. Choix d’écrasement
  const choixEcrasement = ui.alert(
    'Écraser les noms existants ?',
    'Oui = remplacer les affectations existantes.\n' +
      'Non = remplir uniquement les cellules actuellement vides.',
    ui.ButtonSet.YES_NO_CANCEL
  );

  if (choixEcrasement === ui.Button.CANCEL) {
    return;
  }

  const ecraser = choixEcrasement === ui.Button.YES;

  // 5. Lecture de SEMAINE_TYPE
  const derniereLigneST = semaineType.getLastRow();

  if (derniereLigneST < 2) {
    ui.alert('La feuille SEMAINE_TYPE est vide.');
    return;
  }

  const donneesST = semaineType
    .getRange(2, 1, derniereLigneST - 1, 10)
    .getValues();

  const modele = {};

  donneesST.forEach(ligne => {
    const jour = String(ligne[0] || '').trim();
    const poste = String(ligne[1] || '').trim();

    if (!jour || !poste) {
      return;
    }

    modele[jour + '|' + poste] = ligne.slice(2, 10);
  });

  const nomsJours = [
    'Dimanche',
    'Lundi',
    'Mardi',
    'Mercredi',
    'Jeudi',
    'Vendredi',
    'Samedi'
  ];

  const debutSemaine = new Date(
    lundi.getFullYear(),
    lundi.getMonth(),
    lundi.getDate(),
    12,
    0,
    0
  );

  const finSemaine = new Date(debutSemaine);
  finSemaine.setDate(finSemaine.getDate() + 4);

  // Colonnes réelles de la feuille mensuelle
  const colonnesBenevoles = [3, 6, 9, 12, 15, 18, 21, 24];
  const colonnesStatuts = [4, 7, 10, 13, 16, 19, 22, 25];

  const donneesMois = feuilleMois.getDataRange().getValues();

  let nomsAjoutes = 0;
  let nomsRemplaces = 0;
  let lignesTraitees = 0;

  // 6. Modification ciblée : aucune réécriture globale de la feuille
  for (let r = 1; r < donneesMois.length; r++) {
    const date = donneesMois[r][0];
    const poste = String(donneesMois[r][1] || '').trim();

    if (!(date instanceof Date) || !poste) {
      continue;
    }

    const dateNormalisee = new Date(
      date.getFullYear(),
      date.getMonth(),
      date.getDate(),
      12,
      0,
      0
    );

    if (dateNormalisee < debutSemaine || dateNormalisee > finSemaine) {
      continue;
    }

    if (posteChoisi && poste !== posteChoisi) {
      continue;
    }

    const jourNom = nomsJours[dateNormalisee.getDay()];
    const nomsModele = modele[jourNom + '|' + poste];

    if (!nomsModele) {
      continue;
    }

    lignesTraitees++;

    for (let i = 0; i < colonnesBenevoles.length; i++) {
      const nouvelleValeur = nomsModele[i] || '';
      const colonneBenevole = colonnesBenevoles[i];
      const colonneStatut = colonnesStatuts[i];

      const celluleBenevole = feuilleMois.getRange(r + 1, colonneBenevole);
      const celluleStatut = feuilleMois.getRange(r + 1, colonneStatut);
      const valeurActuelle = celluleBenevole.getValue();

      if (ecraser) {
        if (valeurActuelle !== nouvelleValeur) {
          nomsRemplaces++;
        }

        celluleBenevole.setValue(nouvelleValeur);

        // Le statut doit être validé à nouveau si un nom est affecté.
        celluleStatut.clearContent();
      } else if (valeurActuelle === '' && nouvelleValeur !== '') {
        celluleBenevole.setValue(nouvelleValeur);
        celluleStatut.clearContent();
        nomsAjoutes++;
      }
    }
  }

  SpreadsheetApp.flush();
  verifierControleQualite();

  const perimetre = posteChoisi
    ? 'poste ' + posteChoisi
    : 'tous les postes';

  journaliser_(
    'Application SEMAINE_TYPE',
    nomMois +
      ' — semaine du ' +
      texteLundi +
      ' — ' +
      perimetre +
      ' — ' +
      lignesTraitees +
      ' ligne(s) traitée(s)'
  );

  ui.alert(
    'Semaine type appliquée.\n\n' +
      'Mois : ' +
      nomMois +
      '\nSemaine : ' +
      texteLundi +
      '\nPérimètre : ' +
      perimetre +
      '\nNoms ajoutés : ' +
      nomsAjoutes +
      '\nNoms remplacés : ' +
      nomsRemplaces
  );
}

function journaliser_(action, detail) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('_CHANGELOG');
  if (!sheet) return;

  sheet.appendRow([
    new Date(),
    action,
    detail
  ]);
}

function forcerRecalculSyntheses_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const feuilles = ['STATISTIQUES', 'TICKETS_PAR_PERSONNE', 'CONTROLE_QUALITE'];

  feuilles.forEach(nom => {
    const sh = ss.getSheetByName(nom);
    if (!sh) return;

    const range = sh.getDataRange();
    const formulas = range.getFormulas();

    for (let r = 0; r < formulas.length; r++) {
      for (let c = 0; c < formulas[r].length; c++) {
        if (formulas[r][c]) {
          range.getCell(r + 1, c + 1).setFormula(formulas[r][c]);
        }
      }
    }
  });

  SpreadsheetApp.flush();
}

function verifierControleQualite() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const controle = ss.getSheetByName('CONTROLE_QUALITE');

  if (!controle) {
    SpreadsheetApp.getUi().alert('Feuille CONTROLE_QUALITE introuvable.');
    return;
  }

  const moisAControler = [
    'JANVIER', 'FÉVRIER', 'MARS', 'AVRIL', 'MAI', 'JUIN',
    'JUILLET', 'AOÛT', 'SEPTEMBRE', 'OCTOBRE', 'NOVEMBRE', 'DÉCEMBRE'
  ];

  const slots = [
    { beneCol: 3, statutCol: 4, ticketCol: 5, nom: 'Matin 1' },
    { beneCol: 6, statutCol: 7, ticketCol: 8, nom: 'Matin 2' },
    { beneCol: 9, statutCol: 10, ticketCol: 11, nom: 'Matin 3' },
    { beneCol: 12, statutCol: 13, ticketCol: 14, nom: 'Matin 4' },
    { beneCol: 15, statutCol: 16, ticketCol: 17, nom: 'Après-midi 1' },
    { beneCol: 18, statutCol: 19, ticketCol: 20, nom: 'Après-midi 2' },
    { beneCol: 21, statutCol: 22, ticketCol: 23, nom: 'Après-midi 3' },
    { beneCol: 24, statutCol: 25, ticketCol: 26, nom: 'Après-midi 4' }
  ];

  const resultats = [];
  const ticketsParSemaine = {};

  moisAControler.forEach(nomMois => {
    const sh = ss.getSheetByName(nomMois);
    if (!sh) return;

    const data = sh.getDataRange().getValues();

    for (let r = 1; r < data.length; r++) {
      const date = data[r][0];
      const poste = data[r][1];

      if (!(date instanceof Date) || !poste) continue;

      slots.forEach(slot => {
        const benevole = data[r][slot.beneCol - 1];
        const statut = data[r][slot.statutCol - 1];
        const ticket = data[r][slot.ticketCol - 1];

        if (!benevole) return;

        if (!statut) {
          resultats.push([
            date,
            poste,
            slot.nom,
            benevole,
            'Présence à valider'
          ]);
        }

        if (ticket === 'Oui') {
          const semaine = getSemaineCle_(date);
          const cle = semaine + '|' + benevole;

          if (!ticketsParSemaine[cle]) {
            ticketsParSemaine[cle] = {
              benevole: benevole,
              semaine: semaine,
              dates: [],
              count: 0
            };
          }

          ticketsParSemaine[cle].count++;
          ticketsParSemaine[cle].dates.push(date);
        }
      });
    }
  });

  Object.keys(ticketsParSemaine).forEach(cle => {
    const item = ticketsParSemaine[cle];

    if (item.count > 3) {
      resultats.push([
        item.dates[0],
        'Tous postes',
        item.semaine,
        item.benevole,
        'Dépassement 3 tickets/semaine : ' + item.count
      ]);
    }
  });

  controle.getRange(2, 1, Math.max(controle.getMaxRows() - 1, 1), 5).clearContent();

  if (resultats.length > 0) {
    controle.getRange(2, 1, resultats.length, 5).setValues(resultats);
  }

  journaliser_('Contrôle qualité', resultats.length + ' anomalie(s) détectée(s)');
  SpreadsheetApp.getUi().alert('Contrôle qualité terminé : ' + resultats.length + ' anomalie(s).');
}

function getSemaineCle_(date) {
  const d = new Date(date.getFullYear(), date.getMonth(), date.getDate());
  const day = d.getDay() || 7;
  d.setDate(d.getDate() - day + 1);

  const lundi = Utilities.formatDate(d, Session.getScriptTimeZone(), 'yyyy-MM-dd');
  return 'Semaine du ' + lundi;
}

function corrigerTicketsMaxSemaine() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const ui = SpreadsheetApp.getUi();

  const moisRep = ui.prompt('Mois à corriger', 'Exemple : JUIN, JUILLET, AOÛT...', ui.ButtonSet.OK_CANCEL);
  if (moisRep.getSelectedButton() !== ui.Button.OK) return;

  const nomMois = moisRep.getResponseText().trim();
  const sh = ss.getSheetByName(nomMois);

  if (!sh) {
    ui.alert('Feuille introuvable : ' + nomMois);
    return;
  }

  const slots = [
    { beneCol: 3, ticketCol: 5 },
    { beneCol: 6, ticketCol: 8 },
    { beneCol: 9, ticketCol: 11 },
    { beneCol: 12, ticketCol: 14 },
    { beneCol: 15, ticketCol: 17 },
    { beneCol: 18, ticketCol: 20 },
    { beneCol: 21, ticketCol: 23 },
    { beneCol: 24, ticketCol: 26 }
  ];

  const data = sh.getDataRange().getValues();
  const compteur = {};
  let corrections = 0;

  for (let r = 1; r < data.length; r++) {
    const date = data[r][0];
    if (!(date instanceof Date)) continue;

    const semaine = getSemaineCle_(date);

    slots.forEach(slot => {
      const benevole = data[r][slot.beneCol - 1];
      const ticket = data[r][slot.ticketCol - 1];

      if (!benevole || ticket !== 'Oui') return;

      const cle = semaine + '|' + benevole;

      if (!compteur[cle]) compteur[cle] = 0;
      compteur[cle]++;

      if (compteur[cle] > 3) {
        sh.getRange(r + 1, slot.ticketCol).setValue('Non');
        corrections++;
      }
    });
  }

  forcerRecalculSyntheses_();
  verifierControleQualite();
  journaliser_('Correction tickets', nomMois + ' : ' + corrections + ' ticket(s) corrigé(s) au-delà de 3/semaine');

  ui.alert('Correction terminée : ' + corrections + ' ticket(s) passés à Non.');
}

function protegerFormulesTickets_(sheet) {
  if (!sheet) {
    throw new Error('Feuille à protéger introuvable.');
  }

  const descriptionPrefix = 'CAFCO_TICKETS_';
  const colonnesTickets = [5, 8, 11, 14, 17, 20, 23, 26];
  const derniereLigne = Math.max(sheet.getLastRow(), 2);
  const utilisateur = Session.getEffectiveUser();

  // Supprime uniquement les anciennes protections créées par ce script.
  const protectionsExistantes = sheet.getProtections(
    SpreadsheetApp.ProtectionType.RANGE
  );

  protectionsExistantes.forEach(function(protection) {
    const description = protection.getDescription() || '';

    if (
      description.indexOf(descriptionPrefix) === 0 &&
      protection.canEdit()
    ) {
      protection.remove();
    }
  });

  colonnesTickets.forEach(function(colonne) {
    const plage = sheet.getRange(
      2,
      colonne,
      derniereLigne - 1,
      1
    );

    const protection = plage
      .protect()
      .setDescription(
        descriptionPrefix +
        sheet.getName() +
        '_COL_' +
        colonne
      );

    // S'assure que le propriétaire / utilisateur courant reste autorisé.
    protection.addEditor(utilisateur);

    const editeurs = protection.getEditors();

    if (editeurs.length > 0) {
      protection.removeEditors(editeurs);
    }

    // À appeler uniquement si le fichier appartient à un domaine Workspace.
    if (protection.canDomainEdit()) {
      protection.setDomainEdit(false);
    }
  });

  SpreadsheetApp.flush();
}
function protegerTicketsMoisExistant() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const ui = SpreadsheetApp.getUi();

  const reponse = ui.prompt(
    'Protéger les tickets',
    'Indique le nom exact du mois, par exemple : JUILLET',
    ui.ButtonSet.OK_CANCEL
  );

  if (reponse.getSelectedButton() !== ui.Button.OK) {
    return;
  }

  const nomMois = reponse.getResponseText().trim().toUpperCase();
  const sheet = ss.getSheetByName(nomMois);

  if (!sheet) {
    ui.alert('Feuille introuvable : ' + nomMois);
    return;
  }

  protegerFormulesTickets_(sheet);

  journaliser_(
    'Protection tickets',
    nomMois + ' : colonnes Ticket protégées'
  );

  ui.alert(
    'Les colonnes Ticket de ' +
    nomMois +
    ' sont maintenant protégées.'
  );
}

function sauvegarderFormulesReference() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const ui = SpreadsheetApp.getUi();

  const nomBackup = '_FORMULES_BACKUP';
  let backup = ss.getSheetByName(nomBackup);

  if (!backup) {
    backup = ss.insertSheet(nomBackup);
  }

  const choix = ui.alert(
    'Sauvegarder les formules',
    'Cette action remplacera la sauvegarde actuelle des formules. Continuer ?',
    ui.ButtonSet.YES_NO
  );

  if (choix !== ui.Button.YES) return;

  backup.clear();

  const feuillesExclues = [
    '_FORMULES_BACKUP',
    '_CHANGELOG',
    '_DOC_SCRIPT',
    '_DOC_FORMULES',
    '_PARAMETRES'
  ];

  const sauvegarde = [
    ['Feuille', 'Cellule', 'Formule']
  ];

  ss.getSheets().forEach(function(sheet) {
    const nom = sheet.getName();

    if (feuillesExclues.includes(nom)) return;

    const range = sheet.getDataRange();
    const formulas = range.getFormulas();

    for (let r = 0; r < formulas.length; r++) {
      for (let c = 0; c < formulas[r].length; c++) {
        if (formulas[r][c]) {
          sauvegarde.push([
            nom,
            range.getCell(r + 1, c + 1).getA1Notation(),
            formulas[r][c]
          ]);
        }
      }
    }
  });

  backup
    .getRange(1, 1, sauvegarde.length, 3)
    .setValues(sauvegarde);

  journaliser_(
    'Sauvegarde formules',
    (sauvegarde.length - 1) + ' formule(s) sauvegardée(s)'
  );

  ui.alert(
    (sauvegarde.length - 1) +
    ' formule(s) sauvegardée(s).'
  );
}


function reparerToutesLesFormules() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const ui = SpreadsheetApp.getUi();

  const backup = ss.getSheetByName('_FORMULES_BACKUP');

  if (!backup || backup.getLastRow() < 2) {
    ui.alert('Aucune sauvegarde de formules disponible.');
    return;
  }

  const choix = ui.alert(
    'Réparer toutes les formules',
    'Les formules sauvegardées vont être restaurées. Les cellules de saisie ne seront pas modifiées.',
    ui.ButtonSet.YES_NO
  );

  if (choix !== ui.Button.YES) return;

  const data = backup
    .getRange(2, 1, backup.getLastRow() - 1, 3)
    .getValues();

  let restaurees = 0;
  let erreurs = 0;

  data.forEach(function(ligne) {
    const nomFeuille = ligne[0];
    const cellule = ligne[1];
    const formule = ligne[2];

    const sheet = ss.getSheetByName(nomFeuille);

    if (!sheet || !cellule || !formule) {
      erreurs++;
      return;
    }

    try {
      sheet.getRange(cellule).setFormula(formule);
      restaurees++;
    } catch (e) {
      erreurs++;
    }
  });

  SpreadsheetApp.flush();

  forcerRecalculSyntheses_();
  verifierControleQualite();

  journaliser_(
    'Réparation formules',
    restaurees +
    ' restaurée(s), ' +
    erreurs +
    ' erreur(s)'
  );

  ui.alert(
    'Réparation terminée.\n\n' +
    'Formules restaurées : ' +
    restaurees +
    '\nErreurs : ' +
    erreurs
  );
}

function reparerFormulesTickets() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const ui = SpreadsheetApp.getUi();

  const modele = ss.getSheetByName('_MODELE_MOIS');

  if (!modele) {
    ui.alert('La feuille _MODELE_MOIS est introuvable.');
    return;
  }

  const feuillesCibles = [
    'JANVIER',
    'FÉVRIER',
    'MARS',
    'AVRIL',
    'MAI',
    'JUIN',
    'JUILLET',
    'AOÛT',
    'SEPTEMBRE',
    'OCTOBRE',
    'NOVEMBRE',
    'DÉCEMBRE'
  ];

  const colonnesTickets = [5, 8, 11, 14, 17, 20, 23, 26];

  let feuillesReparees = 0;
  let formulesReparees = 0;

  feuillesCibles.forEach(function(nomFeuille) {
    const feuille = ss.getSheetByName(nomFeuille);

    if (!feuille) {
      return;
    }

    const derniereLigne = feuille.getLastRow();

    if (derniereLigne < 2) {
      return;
    }

    colonnesTickets.forEach(function(colonne) {
      const celluleModele = modele.getRange(2, colonne);
      const formuleModele = celluleModele.getFormula();

      if (!formuleModele) {
        throw new Error(
          'Aucune formule de référence dans ' +
          modele.getName() +
          '!' +
          celluleModele.getA1Notation()
        );
      }

      const destination = feuille.getRange(
        2,
        colonne,
        derniereLigne - 1,
        1
      );

      celluleModele.copyTo(
        destination,
        SpreadsheetApp.CopyPasteType.PASTE_FORMULA,
        false
      );

      formulesReparees += derniereLigne - 1;
    });

    feuillesReparees++;
  });

  SpreadsheetApp.flush();
  forcerRecalculSyntheses_();

  journaliser_(
    'Réparation formules Ticket',
    feuillesReparees +
      ' feuille(s), ' +
      formulesReparees +
      ' formule(s) restaurée(s) depuis _MODELE_MOIS'
  );

  ui.alert(
    'Réparation terminée.\n\n' +
      'Feuilles réparées : ' +
      feuillesReparees +
      '\nFormules restaurées : ' +
      formulesReparees
  );
}

function recalculerTicketsMois() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const ui = SpreadsheetApp.getUi();

  const reponse = ui.prompt(
    'Recalculer les tickets',
    'Indique le mois, par exemple : JUILLET',
    ui.ButtonSet.OK_CANCEL
  );

  if (reponse.getSelectedButton() !== ui.Button.OK) {
    return;
  }

  const nomMois = reponse.getResponseText().trim().toUpperCase();
  const sheet = ss.getSheetByName(nomMois);

  if (!sheet) {
    ui.alert('Feuille introuvable : ' + nomMois);
    return;
  }

  const benevolesSheet = ss.getSheetByName('BENEVOLES');

  if (!benevolesSheet) {
    ui.alert('Feuille BENEVOLES introuvable.');
    return;
  }

  const derniereLigne = sheet.getLastRow();

  if (derniereLigne < 2) {
    ui.alert('Aucune donnée à traiter dans ' + nomMois + '.');
    return;
  }

  // Lecture unique du planning.
  const planning = sheet
    .getRange(2, 1, derniereLigne - 1, 26)
    .getValues();

  // Lecture unique de BENEVOLES.
  const benevolesData = benevolesSheet
    .getRange(2, 1, Math.max(benevolesSheet.getLastRow() - 1, 1), 9)
    .getValues();

  const infosBenevoles = {};

  benevolesData.forEach(function(ligne) {
    const nom = String(ligne[0] || '').trim();

    if (!nom) {
      return;
    }

    infosBenevoles[nom] = {
      souhaiteTicket: ligne[6],
      statutAutomatique: ligne[7]
    };
  });

  const slots = [
    { benevoleIndex: 2, statutIndex: 3, ticketIndex: 4 },
    { benevoleIndex: 5, statutIndex: 6, ticketIndex: 7 },
    { benevoleIndex: 8, statutIndex: 9, ticketIndex: 10 },
    { benevoleIndex: 11, statutIndex: 12, ticketIndex: 13 },
    { benevoleIndex: 14, statutIndex: 15, ticketIndex: 16 },
    { benevoleIndex: 17, statutIndex: 18, ticketIndex: 19 },
    { benevoleIndex: 20, statutIndex: 21, ticketIndex: 22 },
    { benevoleIndex: 23, statutIndex: 24, ticketIndex: 25 }
  ];

  const compteurs = {};
  let ticketsOui = 0;
  let ticketsNon = 0;
  let ticketsVides = 0;

  for (let r = 0; r < planning.length; r++) {
    const date = planning[r][0];

    if (!(date instanceof Date)) {
      slots.forEach(function(slot) {
        planning[r][slot.ticketIndex] = '';
        ticketsVides++;
      });
      continue;
    }

    const semaine = getSemaineCle_(date);

    slots.forEach(function(slot) {
      const benevole = String(
        planning[r][slot.benevoleIndex] || ''
      ).trim();

      const presence = String(
        planning[r][slot.statutIndex] || ''
      ).trim();

      let resultat = '';

      if (!benevole || !presence) {
        resultat = '';
      } else if (presence !== 'Présent') {
        resultat = 'Non';
      } else {
        const infos = infosBenevoles[benevole];

        if (
          !infos ||
          infos.souhaiteTicket !== 'Oui' ||
          (
            infos.statutAutomatique !== 'Bénévole' &&
            infos.statutAutomatique !== 'Référent'
          )
        ) {
          resultat = 'Non';
        } else {
          const cle = semaine + '|' + benevole;
          const nombreDejaAttribue = compteurs[cle] || 0;

          if (nombreDejaAttribue < 3) {
            resultat = 'Oui';
            compteurs[cle] = nombreDejaAttribue + 1;
          } else {
            resultat = 'Non';
          }
        }
      }

      planning[r][slot.ticketIndex] = resultat;

      if (resultat === 'Oui') {
        ticketsOui++;
      } else if (resultat === 'Non') {
        ticketsNon++;
      } else {
        ticketsVides++;
      }
    });
  }

  // Écrit seulement les huit colonnes Ticket, une fois par colonne.
  slots.forEach(function(slot) {
    const valeurs = planning.map(function(ligne) {
      return [ligne[slot.ticketIndex]];
    });

    sheet
      .getRange(2, slot.ticketIndex + 1, valeurs.length, 1)
      .setValues(valeurs);
  });

  SpreadsheetApp.flush();
  forcerRecalculSyntheses_();

  journaliser_(
    'Recalcul tickets',
    nomMois +
      ' : ' +
      ticketsOui +
      ' Oui, ' +
      ticketsNon +
      ' Non, ' +
      ticketsVides +
      ' vide(s)'
  );

  ui.alert(
    'Tickets recalculés pour ' +
      nomMois +
      '.\n\nOui : ' +
      ticketsOui +
      '\nNon : ' +
      ticketsNon +
      '\nVides : ' +
      ticketsVides
  );
}
