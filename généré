function genererMoisDepuisModele() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const ui = SpreadsheetApp.getUi();

  const params = lireParametres_();

  const anneeRep = ui.prompt(
    'Année',
    'Exemple : ' + params.anneeActive,
    ui.ButtonSet.OK_CANCEL
  );
  if (anneeRep.getSelectedButton() !== ui.Button.OK) return;

  const moisRep = ui.prompt(
    'Mois',
    'Numéro du mois : 1 à 12',
    ui.ButtonSet.OK_CANCEL
  );
  if (moisRep.getSelectedButton() !== ui.Button.OK) return;

  const annee = Number(anneeRep.getResponseText());
  const mois = Number(moisRep.getResponseText());

  if (!annee || mois < 1 || mois > 12) {
    ui.alert('Année ou mois invalide.');
    return;
  }

  const nomsMois = [
    'JANVIER',
    'FÉVRIER',
    'MARS',
    'AVRIL',
    'MAI',
    'JUIN',
    'JUILLET',
    'AOÛT',
    'SEPTEMBRE',
    'OCTOBRE',
    'NOVEMBRE',
    'DÉCEMBRE'
  ];

  const nomFeuille = nomsMois[mois - 1];
  const modele = ss.getSheetByName(params.modeleMois);

  if (!modele) {
    ui.alert('Feuille modèle introuvable : ' + params.modeleMois);
    return;
  }

  const existante = ss.getSheetByName(nomFeuille);

  if (existante) {
    const choix = ui.alert(
      nomFeuille + ' existe déjà',
      'Supprimer et recréer cette feuille ?',
      ui.ButtonSet.YES_NO
    );

    if (choix !== ui.Button.YES) return;

    ss.deleteSheet(existante);
  }

  const nouvelle = modele.copyTo(ss).setName(nomFeuille);
  ss.setActiveSheet(nouvelle);

  const lignes = construireLignesMois_(annee, mois, params);

  ajusterNombreLignes_(
    nouvelle,
    lignes.length,
    params.postes.length
  );

  nettoyerMoisV2_(nouvelle);
  ecrireDatesEtPostesV2_(nouvelle, lignes);
  
  protegerFormulesTickets_(nouvelle);


  forcerRecalculSyntheses_();

  journaliser_(
    'Génération mois V2',
    nomFeuille +
      ' ' +
      annee +
      ' généré : ' +
      lignes.length +
      ' ligne(s)'
  );

  ui.alert(
    nomFeuille +
      ' ' +
      annee +
      ' généré avec ' +
      lignes.length +
      ' ligne(s).'
  );
}

function lireParametres_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName('_PARAMETRES');

  if (!sh) {
    throw new Error('Feuille _PARAMETRES introuvable.');
  }

  const values = sh.getDataRange().getValues();
  const map = {};

  for (let i = 1; i < values.length; i++) {
    const cle = values[i][0];
    const valeur = values[i][1];

    if (cle) {
      map[String(cle).trim()] = valeur;
    }
  }

  return {
    anneeActive:
      Number(map['Année active']) ||
      new Date().getFullYear(),

    modeleMois:
      String(map['Modèle mois'] || '_MODELE_MOIS').trim(),

    postes:
      splitParam_(map['Postes']),

    joursOuvres:
      splitParam_(map['Jours ouvrés']),

    benevolesMaxMatin:
      Number(map['Bénévoles max matin']) || 4,

    benevolesMaxApresMidi:
      Number(map['Bénévoles max après-midi']) || 4
  };
}

function splitParam_(valeur) {
  if (!valeur) return [];

  return String(valeur)
    .split(',')
    .map(function(v) {
      return v.trim();
    })
    .filter(function(v) {
      return v !== '';
    });
}

function construireLignesMois_(annee, mois, params) {
  const joursNoms = {
    0: 'Dimanche',
    1: 'Lundi',
    2: 'Mardi',
    3: 'Mercredi',
    4: 'Jeudi',
    5: 'Vendredi',
    6: 'Samedi'
  };

  const dernierJour = new Date(annee, mois, 0).getDate();
  const lignes = [];

  for (let jour = 1; jour <= dernierJour; jour++) {
    const date = new Date(
      annee,
      mois - 1,
      jour,
      12,
      0,
      0
    );

    const jourNom = joursNoms[date.getDay()];

    if (!params.joursOuvres.includes(jourNom)) {
      continue;
    }

    params.postes.forEach(function(poste) {
      lignes.push([date, poste]);
    });
  }

  return lignes;
}
function ajusterNombreLignes_(sheet, nbLignesDonnees, nbPostes) {
  const lignesNecessaires = nbLignesDonnees + 1;
  const derniereLigneStructuree = sheet.getLastRow();

  if (!nbPostes || nbPostes < 1) {
    throw new Error('Le nombre de postes est invalide.');
  }

  if (derniereLigneStructuree < lignesNecessaires) {
    const nbLignesAjouter =
      lignesNecessaires - derniereLigneStructuree;

    if (nbLignesAjouter % nbPostes !== 0) {
      throw new Error(
        'Nombre de lignes à compléter invalide : ' +
        nbLignesAjouter
      );
    }

    const premiereLigneModele =
      derniereLigneStructuree - nbPostes + 1;

    const blocModele = sheet.getRange(
      premiereLigneModele,
      1,
      nbPostes,
      sheet.getMaxColumns()
    );

    for (
      let offset = 0;
      offset < nbLignesAjouter;
      offset += nbPostes
    ) {
      const destination = sheet.getRange(
        derniereLigneStructuree + 1 + offset,
        1,
        nbPostes,
        sheet.getMaxColumns()
      );

      blocModele.copyTo(
        destination,
        SpreadsheetApp.CopyPasteType.PASTE_NORMAL,
        false
      );
    }
  }

  if (sheet.getMaxRows() > lignesNecessaires) {
    sheet.deleteRows(
      lignesNecessaires + 1,
      sheet.getMaxRows() - lignesNecessaires
    );
  }
}

    

function nettoyerMoisV2_(sheet) {
  const maxRows = sheet.getMaxRows();

  if (maxRows <= 1) return;

  const colonnesASaisir = [
    3, 4,
    6, 7,
    9, 10,
    12, 13,
    15, 16,
    18, 19,
    21, 22,
    24, 25
  ];

  colonnesASaisir.forEach(function(col) {
    sheet
      .getRange(2, col, maxRows - 1, 1)
      .clearContent();
  });
}

function ecrireDatesEtPostesV2_(sheet, lignes) {
  if (!lignes.length) return;

  sheet
    .getRange(2, 1, lignes.length, 2)
    .setValues(lignes);
}
